<Application x:Class="WaveBoostManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- 颜色资源 -->
        <SolidColorBrush x:Key="BgBrush" Color="#0F1220"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161A2E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1E33"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#20253F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B6EF5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A8FA8"/>
        <SolidColorBrush x:Key="RedBrush" Color="#FF5C6A"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#3DDC84"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#20243B"/>

        <!-- 通用窗口样式 -->
        <Style x:Key="BaseWindowStyle" TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <!--
            注意：WindowStartupLocation 不是依赖属性（DependencyProperty），
            不能放进 Style 的 Setter 里设置，否则运行时会抛异常。
            需要哪个窗口居中，就直接在该 Window 标签上写
            WindowStartupLocation="CenterScreen" 或 "CenterOwner"。
        -->

        <!-- 顶部导航按钮 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#242A45"/>
            <Setter Property="Foreground" Value="#D8DAF0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 卡片内操作按钮基础样式 -->
        <Style x:Key="ActionBtnBase" TargetType="Button">
            <Setter Property="Background" Value="#262C4A"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnBase}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="TerminateBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnBase}">
            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        </Style>
        <Style x:Key="SettleBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnBase}">
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
        </Style>

        <!-- 主要按钮（保存/创建/确认） -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,9"/>
        </Style>

        <!-- 次要按钮（取消/关闭） -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnBase}">
            <Setter Property="Background" Value="#262C4A"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="20,9"/>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33385A"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签文字 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </Application.Resources>
</Application>
