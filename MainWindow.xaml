<Window x:Class="WaveBoostManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="代肝任务面板" Height="740" Width="1020"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- 顶部导航栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="代肝任务面板" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="进行中的委托，从上到下按接单时间排列" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="历史记录" Style="{StaticResource NavButtonStyle}" Click="BtnHistory_Click" Margin="0,0,10,0"/>
                    <Button Content="☀/☾ 主题" Style="{StaticResource NavButtonStyle}" Click="BtnTheme_Click" Margin="0,0,10,0"/>
                    <Button Content="＋ 创建" Style="{StaticResource CreateNavButtonStyle}" Click="BtnCreate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 空状态提示 -->
        <TextBlock x:Name="TxtEmptyHint"
                   DockPanel.Dock="Top"
                   Text="暂无进行中的代肝任务，点击右上角「创建」添加一个吧～"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="14" Margin="24,20,24,0"
                   Visibility="Collapsed"/>

        <!-- 任务列表 -->
        <ScrollViewer Padding="24,20,24,20" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TaskList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 排名徽标，模仿直播间观众面板 -->
                                <Border Grid.Column="0" Background="#2A2F4A" CornerRadius="17" Width="36" Height="36" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding RankDisplay}" Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- 标题与简要信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SubInfo}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 操作按钮：查看 / 终止 / 结算 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="查看" Style="{StaticResource ViewBtnStyle}" Click="View_Click" Margin="0,0,8,0"/>
                                    <Button Content="终止" Style="{StaticResource TerminateBtnStyle}" Click="Terminate_Click" Margin="0,0,8,0"/>
                                    <Button Content="结算" Style="{StaticResource SettleBtnStyle}" Click="Settle_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
