<Window x:Class="WaveBoostManager.Windows.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="板块详情" Height="640" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 状态标签 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock x:Name="TxtTitle" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Border Background="#20253F" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TxtMeta" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,20"/>

        <!-- 需求描述 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="需求描述" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="TxtDescription" Style="{StaticResource InputBoxStyle}"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- 笔录标题 -->
        <TextBlock Grid.Row="3" Text="跟进笔录" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8"/>

        <!-- 笔录列表 -->
        <Border Grid.Row="4" Background="#161A2E" CornerRadius="8" Padding="4" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeText}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 新增笔录输入区 -->
        <Grid Grid.Row="5" Margin="0,0,0,16" x:Name="AddNotePanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtNewNote" Grid.Column="0" Style="{StaticResource InputBoxStyle}"
                     Height="44" MinHeight="44" VerticalContentAlignment="Center" Padding="10,0"/>
            <Button x:Name="BtnAddNote" Grid.Column="1" Content="添加笔录" Style="{StaticResource PrimaryBtnStyle}"
                    Margin="10,0,0,0" Click="BtnAddNote_Click"/>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Style="{StaticResource SecondaryBtnStyle}" Click="BtnClose_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnSave" Content="保存修改" Style="{StaticResource PrimaryBtnStyle}" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
