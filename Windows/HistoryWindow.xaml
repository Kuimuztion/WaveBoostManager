<Window x:Class="WaveBoostManager.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="历史记录" Height="640" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="历史记录" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="已结算或已终止的板块都会显示在这里"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

        <TextBlock x:Name="TxtEmptyHint" DockPanel.Dock="Top"
                   Text="暂无历史记录～"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                   Visibility="Collapsed" Margin="0,20,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="#20253F" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding StatusColor}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HistorySubInfo}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="查看" Style="{StaticResource ViewBtnStyle}"
                                        Click="View_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
